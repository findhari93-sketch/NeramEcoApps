# Copy to .env.test and fill in the blanks. Loaded first by playwright.config.ts.
# .env.test is gitignored; this template is not. Never commit real values here.
#
# Test accounts are Microsoft Entra ID users with MFA disabled so Playwright can
# drive them. See CLAUDE.md "E2E Test Credentials".

# --- Nexus / Admin (Microsoft Entra ID) ---
E2E_TEST_STUDENT_EMAIL=e2etestingstudent@neramclasses.com
E2E_TEST_STUDENT_PASSWORD=
E2E_TEST_TEACHER_EMAIL=e2etestingteacher@neramclasses.com
E2E_TEST_TEACHER_PASSWORD=
E2E_TEST_ADMIN_EMAIL=e2etestingteacher@neramclasses.com
E2E_TEST_ADMIN_PASSWORD=

# Must match NERAM_STAFF_ADMIN_SECRET on the server under test.
E2E_STAFF_SECRET=

# --- Student app (apps/app, port 3011) ---
# Disables the Firebase phone-auth reCAPTCHA for registered test numbers.
# NOTE: NEXT_PUBLIC_* is inlined at BUILD time, so under `next start` this must
# be set on the `next build` step instead of at run time.
NEXT_PUBLIC_E2E_TEST_MODE=true
# A Firebase email/password user in the STAGING project. The Google sign-in
# popup cannot be automated, so email/password is used instead.
E2E_TEST_APP_EMAIL=
E2E_TEST_APP_PASSWORD=
# A registered Firebase test phone number and its fixed OTP.
E2E_TEST_PHONE_NUMBER=
E2E_TEST_FIXED_OTP=

# --- Parent portal ---
# Parents sign in with an admin-issued login ID, not an email address.
# tests/utils/credentials.ts reads E2E_TEST_PARENT_LOGIN_ID.
E2E_TEST_PARENT_LOGIN_ID=
E2E_TEST_PARENT_PASSWORD=

# --- Optional: point the suite at something other than localhost ---
# See APP_URLS in tests/utils/credentials.ts.
# E2E_MARKETING_URL=http://localhost:3010
# E2E_APP_URL=http://localhost:3011
# E2E_NEXUS_URL=http://localhost:3012
# E2E_ADMIN_URL=http://localhost:3013

# --- Optional: serve an app from a production build during E2E ---
# Comma-separated app names. Only `marketing` is safe: `next start` forces
# NODE_ENV=production, which Next inlines at build time. That 404s the nexus
# test-login routes and activates the next-pwa service worker in nexus/app/admin.
# E2E_PROD_SERVERS=marketing
