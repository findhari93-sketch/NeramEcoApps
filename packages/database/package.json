{
  "name": "@neram/database",
  "version": "1.0.0",
  "private": true,
  "description": "Supabase database client and types for Neram Classes",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./types": "./src/types/index.ts",
    "./queries": "./src/queries/index.ts",
    "./queries/nexus": "./src/queries/nexus/index.ts",
    "./analytics": "./src/analytics/index.ts",
    "./demo-schedule": "./src/utils/demo-schedule.ts",
    "./demo-follow-up": "./src/utils/demo-follow-up.ts",
    "./drawing-grade": "./src/queries/nexus/drawing-grade.ts",
    "./signup-geo": "./src/utils/signup-geo.ts",
    "./staff-push": "./src/services/staff-push.ts",
    "./signup-alert": "./src/services/signup-alert.ts"
  },
  "scripts": {
    "generate": "supabase gen types typescript --project-id $SUPABASE_PROJECT_ID > src/types/supabase.ts",
    "push": "supabase db push",
    "pull": "supabase db pull",
    "studio": "supabase studio",
    "migrate": "supabase migration up",
    "lint": "echo 'Linted via consuming apps'",
    "type-check": "echo 'Type-checked via consuming apps'",
    "clean": "rm -rf dist .turbo node_modules",
    "clean:build": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "resend": "^2.1.0",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@types/web-push": "3.6.4",
    "typescript": "^5.3.3"
  }
}
