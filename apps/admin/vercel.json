{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": { "deploymentEnabled": false },
  "framework": "nextjs",
  "regions": ["sin1"],
  "crons": [
    { "path": "/api/cron/sync-ms-photos", "schedule": "0 20 * * 0" },
    { "path": "/api/cron/identity-sweep", "schedule": "45 21 * * *" },
    { "path": "/api/cron/marketing-ai/ingest", "schedule": "30 0 * * *" },
    { "path": "/api/cron/marketing-ai/analyze", "schedule": "0 1 * * *" },
    { "path": "/api/cron/marketing-ai/conversions", "schedule": "15 */6 * * *" },
    { "path": "/api/cron/marketing-ai/weekly", "schedule": "0 2 * * 1" },
    { "path": "/api/cron/demo-messages", "schedule": "*/5 * * * *" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/_next/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/:path*" }
  ]
}
