# ============================================
# NERAM CLASSES ECOSYSTEM - ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env.local and fill in the values

# --------------------------------------------
# SUPABASE (Backend Database)
# --------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://db.neramclasses.com
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_PROJECT_ID=your-project-id
# Optional, server only (never NEXT_PUBLIC_). The direct Supabase URL, e.g.
# https://<project-ref>.supabase.co. When set, server-side clients (admin, ISR,
# server) skip the db.neramclasses.com Cloudflare hop; browsers keep using
# NEXT_PUBLIC_SUPABASE_URL. Leave unset to keep every request on the proxy.
# SUPABASE_SERVER_URL=https://your-project-ref.supabase.co

# --------------------------------------------
# NEXUS "View as Student" (impersonation)
# --------------------------------------------
# Server-only secret used to sign short-lived impersonation tokens so a
# teacher/admin can view the app as a real student. Use a long random string.
# Set in the neram-nexus-new Vercel project (production AND preview).
IMPERSONATION_JWT_SECRET=your-long-random-secret

# --------------------------------------------
# NEXUS media Worker (class recordings served from Cloudflare, not Vercel)
# --------------------------------------------
# Optional. When set, video grants point at the Worker (cloudflare/media-proxy)
# instead of /api/media/recording. Unset it to roll back.
# MEDIA_PROXY_ORIGIN=https://media.neramclasses.com
# Shared with the Worker (wrangler secret put MEDIA_PROXY_SECRET). Authenticates
# the Worker's server-to-server call to /api/media/recording/source.
# MEDIA_PROXY_SECRET=your-long-random-secret

# --------------------------------------------
# FIREBASE (Phone/Email Auth for app.neramclasses.com)
# --------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# --------------------------------------------
# MICROSOFT ENTRA ID (Auth for nexus & admin)
# --------------------------------------------
NEXT_PUBLIC_AZURE_AD_CLIENT_ID=your-client-id
NEXT_PUBLIC_AZURE_AD_TENANT_ID=your-tenant-id
AZURE_AD_CLIENT_SECRET=your-client-secret
AZURE_AD_REDIRECT_URI=https://nexus.neramclasses.com/api/auth/callback/azure-ad

# Microsoft Graph API (for creating users, Teams integration)
# NOTE: these three are not read by any code. The vars actually used for app-only
# Graph calls are the AZ_* trio below. Kept only to avoid breaking older docs.
MS_GRAPH_CLIENT_ID=your-graph-client-id
MS_GRAPH_CLIENT_SECRET=your-graph-client-secret
MS_GRAPH_TENANT_ID=your-tenant-id

# App-only (client credentials) Microsoft Graph access. THESE are the ones the
# code reads: packages/auth/src/graph.ts and apps/nexus/src/lib/graph-app-token.ts.
# Used for Teams membership, SharePoint, recordings, transcripts, and attendance.
#
# Teams meeting ATTENDANCE additionally needs, on the same app registration:
#   - Application permission OnlineMeetings.Read.All        (admin consent)
#   - Application permission OnlineMeetingArtifact.Read.All (admin consent)
#   - A Teams application access policy granting this app rights over the meeting
#     organizer, granted tenant-wide:
#       New-CsApplicationAccessPolicy -Identity Nexus-Attendance-Read -AppIds "<AZ_CLIENT_ID>"
#       Grant-CsApplicationAccessPolicy -PolicyName Nexus-Attendance-Read -Global
# Check the live state with GET /api/timetable/attendance-diagnostics as staff.
AZ_CLIENT_ID=your-azure-app-client-id
AZ_CLIENT_SECRET=your-azure-app-client-secret
AZ_TENANT_ID=your-azure-tenant-id

# Shared secret for Vercel Cron invocations. When set, Vercel sends it as
# `Authorization: Bearer $CRON_SECRET` and /api/cron/* routes reject anything else.
# Leave blank in local dev to call cron routes directly from a browser.
CRON_SECRET=

# Instant UPI watchers (marketing project). JSON of device id -> secret, one entry per
# watcher: the office phone's SMS/notification forwarder and the Gmail Apps Script.
# A device signs each post with HMAC-SHA256(secret, timestamp.nonce.body) or, for
# forwarder apps that cannot compute an HMAC, sends the secret as x-neram-token.
# Rotate by adding a new id, moving the device, then removing the old id.
# Example: {"office-phone-1":"<32+ random chars>","gmail-script":"<32+ random chars>"}
PAYMENT_WATCHER_SECRETS=

# "Neram Assistant" Teams app catalog id. When set, assignment/study reminders are
# delivered to the student's Teams Activity feed (the bell), separate from chats.
# Get it after uploading the apps/nexus/teams-app package to the org Teams catalog
# (Teams admin center > Manage apps). Leave blank to fall back to in-app + email.
TEAMS_APP_CATALOG_ID=

# --------------------------------------------
# RAZORPAY (Payments)
# --------------------------------------------
RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=your-secret-key
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxx

# --------------------------------------------
# EMAIL (Resend)
# --------------------------------------------
RESEND_API_KEY=re_xxxxx
# Sender address for all transactional emails. Will change to noreply@neramclasses.com after domain transfer.
EMAIL_FROM_ADDRESS=Neram Classes <noreply@neram.co.in>
ADMIN_EMAIL=admin@neramclasses.com
# Secret key for signing unsubscribe tokens in drip emails (min 32 chars, random)
UNSUBSCRIBE_JWT_SECRET=your-random-32-char-secret-here

# --------------------------------------------
# YOUTUBE API (For subscription verification)
# --------------------------------------------
YOUTUBE_API_KEY=your-youtube-api-key
NERAM_YOUTUBE_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxx

# --------------------------------------------
# YOUTUBE UPLOAD (Nexus: automatic class recording backup)
# --------------------------------------------
# A SEPARATE OAuth client from the one apps/app uses for the student
# subscription check. That client is consented by students on a different
# redirect URI, and adding the upload scope to it would show every student a
# "upload videos to your YouTube account" prompt.
#
# The consent screen MUST be published "In production". A screen left in
# "Testing" issues refresh tokens that expire after 7 days, so the nightly
# backup would work for a week and then stop silently.
#
# Quota is per GCP project: videos.insert costs 1600 of 10,000 units per day.
# Check which project the client lives in before creating it.
#
# The refresh token is NOT an env var. It is stored in nexus_youtube_credentials
# by the one-time consent flow at /api/admin/youtube-oauth/start, so it can be
# re-keyed by an admin without a redeploy.
YOUTUBE_UPLOAD_CLIENT_ID=your-upload-oauth-client-id.apps.googleusercontent.com
YOUTUBE_UPLOAD_CLIENT_SECRET=your-upload-oauth-client-secret
YOUTUBE_UPLOAD_REDIRECT_URI=https://nexus.neramclasses.com/api/admin/youtube-oauth/callback

# --------------------------------------------
# WHATSAPP (Meta Cloud API - optional)
# --------------------------------------------
# Get these from Meta Business Manager → WhatsApp → API Setup
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
# Use a permanent System User token (Business Settings > System Users). The token
# shown on API Setup expires after 24 hours, which silently stops every send.
WHATSAPP_ACCESS_TOKEN=your-access-token
# Optional, admin only: lets Admin > Demo classes > WhatsApp status list template approvals.
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Staff phone alerts (Web Push): new sign-up notifications to the admin app.
# Same pair on app, marketing and admin. Generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@neramclasses.com

# --------------------------------------------
# DEMO CLASS (admin app)
# --------------------------------------------
# Confirming a demo creates a Teams meeting on the host's calendar through the
# app behind AZ_CLIENT_ID; it needs the Graph APPLICATION permission
# Calendars.ReadWrite with admin consent. "true" skips Graph and saves a fake
# link: use it locally, on staging, and in E2E.
DEMO_TEAMS_DRY_RUN=true
# /api/cron/demo-messages (every 5 min) also needs CRON_SECRET (above) on the admin project.

# --------------------------------------------
# MICROSOFT TEAMS (Incoming Webhook for notifications)
# --------------------------------------------
TEAMS_WEBHOOK_URL=

# --------------------------------------------
# TAWK.TO (Chat Widget for Marketing Site)
# --------------------------------------------
NEXT_PUBLIC_TAWK_PROPERTY_ID=your-property-id
NEXT_PUBLIC_TAWK_WIDGET_ID=your-widget-id

# --------------------------------------------
# APP CONFIGURATION
# --------------------------------------------
NEXT_PUBLIC_MARKETING_URL=https://neramclasses.com
NEXT_PUBLIC_APP_URL=https://app.neramclasses.com
NEXT_PUBLIC_NEXUS_URL=https://nexus.neramclasses.com
NEXT_PUBLIC_ADMIN_URL=https://admin.neramclasses.com

# --------------------------------------------
# VERCEL (Deployment)
# --------------------------------------------
VERCEL_TOKEN=your-vercel-token
VERCEL_ORG_ID=your-org-id
VERCEL_PROJECT_ID_MARKETING=your-project-id
VERCEL_PROJECT_ID_APP=your-project-id
VERCEL_PROJECT_ID_NEXUS=your-project-id
VERCEL_PROJECT_ID_ADMIN=your-project-id

# --------------------------------------------
# AI Drawing Feedback (Nexus drawing module)
# --------------------------------------------
# Gemini is FREE (15 RPM, 1M tokens/day) — recommended to start
# Get key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
# Optional: the AI Tutor's own key (a separate Google Cloud project), so its
# spend is billed and capped on its own. Unset = the tutor uses GEMINI_API_KEY.
GEMINI_API_KEY_TUTOR=
# Optional backups for Nexus and Marketing TEXT features, used when every Gemini call
# fails (credit, rate limit, outage). Images always wait for Gemini.
# Groq: https://console.groq.com/keys   OpenRouter: https://openrouter.ai/keys
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Optional comma-separated model overrides. Defaults are in packages/ai/src/fallback.ts.
GROQ_MODELS=
OPENROUTER_MODELS=
# Anthropic is paid — optional fallback if Gemini key is not set
ANTHROPIC_API_KEY=sk-ant-xxxxx

# --------------------------------------------
# GOOGLE ADS BROWSER TAG (app + marketing, Vercel PRODUCTION only so staging never counts)
# --------------------------------------------
# Loaded by @neram/ui/analytics GoogleTag, only on neramclasses.com, www. and app. (never on
# *.vercel.app previews, staging or localhost). Public, compiled into the JS.
# Spec: apps/marketing/Docs/GOOGLE_ADS_TRACKING_IMPLEMENTATION.md
NEXT_PUBLIC_GOOGLE_ADS_ID=
# "Sign-up (OTP verified)" (G5yMCLzC95ocEOq2qekC): an account's first phone verification, once.
NEXT_PUBLIC_GADS_LABEL_SIGNUP=
# "Application Submitted" (T2hTCJOWlYUcEOq2qekC): the account's first submitted application, once.
NEXT_PUBLIC_GADS_LABEL_APPLICATION=
# Phone-call conversion on tel: link clicks.
NEXT_PUBLIC_GOOGLE_ADS_CALL_LABEL=
# GA4 measurement id (optional). The tag configures GA4 only when this is set.
NEXT_PUBLIC_GA4_ID=

# --------------------------------------------
# MARKETING INTELLIGENCE: GOOGLE ADS AGENT (admin app only, server-side only)
# --------------------------------------------
# Never NEXT_PUBLIC_*. See docs/marketing-intelligence/README.md for setup.
# mock (default) serves a sample account; live reads the real one.
GOOGLE_ADS_MODE=mock
# Optional, mock mode only: not_serving makes the sample account stop showing ads 10 days ago.
GOOGLE_ADS_MOCK_SCENARIO=
# Optional since 2026-09-09 (access now comes from the Google Cloud project). Leave empty.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
# Minted once with scripts/google-ads-auth.ts
GOOGLE_ADS_REFRESH_TOKEN=
# Digits only (dashes are stripped): the ad account; the manager (MCC) id only if you sign in through one
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Offline conversion actions (Google Ads > Goals > Conversions > Import > clicks), ids only.
# The browser tag already counts the OTP-verified sign-up as "Sign-up (OTP verified)" (the PRIMARY
# conversion, see NEXT_PUBLIC_GADS_LABEL_SIGNUP). If you also upload it here,
# make "Phone verified (Neram app)" SECONDARY in Google Ads, or every sign-up counts twice.
GOOGLE_ADS_CONV_ACTION_PHONE=
# Optional, secondary (reporting only)
GOOGLE_ADS_CONV_ACTION_DEMO=
# "Demo Attended" (Import > CRM), from the demo_attended funnel stage
GOOGLE_ADS_CONV_ACTION_DEMO_ATTENDED=
GOOGLE_ADS_CONV_ACTION_PAID=
# 'true' ONLY on production. Anything else: every change is a validate-only dry run.
MARKETING_AI_ALLOW_MUTATIONS=
# Comma-separated emails for the morning digest. Empty = no email.
MARKETING_AI_DIGEST_TO=
# Optional: gemini | mock. Defaults to mock when GOOGLE_ADS_MODE=mock.
MARKETING_AI_ANALYST=
# Optional: override the Google Ads API version (default v25)
GOOGLE_ADS_API_VERSION=

# --------------------------------------------
# ANALYTICS (Optional)
# --------------------------------------------
NEXT_PUBLIC_CLARITY_PROJECT_ID=your-clarity-id

# --------------------------------------------
# SEO AUTOMATION
# --------------------------------------------
INDEXNOW_API_KEY=your-indexnow-key
PAGESPEED_API_KEY=your-pagespeed-api-key

# --------------------------------------------
# E2E TESTING (Playwright)
# --------------------------------------------
# Create dedicated test accounts in your STAGING Firebase/Supabase projects.
# Enable Email/Password auth in Firebase Console for these accounts.
# These are only used for automated E2E testing.

# Student test account (Microsoft Entra ID - MFA disabled for E2E)
E2E_TEST_STUDENT_EMAIL=e2etestingstudent@neramclasses.com
E2E_TEST_STUDENT_PASSWORD=change-me

# Teacher test account (Microsoft Entra ID - MFA disabled for E2E)
E2E_TEST_TEACHER_EMAIL=e2etestingteacher@neramclasses.com
E2E_TEST_TEACHER_PASSWORD=change-me

# Admin test account (uses same Microsoft auth as teacher)
E2E_TEST_ADMIN_EMAIL=e2etestingteacher@neramclasses.com
E2E_TEST_ADMIN_PASSWORD=change-me

# Parent test account (read-only access)
E2E_TEST_PARENT_EMAIL=test-parent@neramclasses.com
E2E_TEST_PARENT_PASSWORD=

# Tools App auth testing (Firebase phone + Google)
# Phone/OTP must be a number REGISTERED under Firebase Auth > Phone > "Phone numbers
# for testing" in the project the app points to:
#   staging (neram-staging): +919999900001 / 123456  (also ...02, ...03)
#   production (neram-ecosystem): +916380194614 / 880743
E2E_TEST_PHONE_NUMBER=+919999900001
E2E_TEST_FIXED_OTP=123456
E2E_TEST_GOOGLE_EMAIL=
E2E_TEST_GOOGLE_PASSWORD=

# Firebase email/password user for the Tools App (Google popup can't be automated
# headless, so phone-auth specs sign in with email/password). Create this user in
# the staging Firebase project with Email/Password auth enabled.
E2E_TEST_APP_EMAIL=
E2E_TEST_APP_PASSWORD=

# Disables Firebase reCAPTCHA (appVerificationDisabledForTesting) so Playwright can
# drive phone OTP with the registered test number. NEVER set in production: it is
# additionally guarded by NODE_ENV !== 'production'. playwright.config.ts sets this
# for the dev:app server automatically.
NEXT_PUBLIC_E2E_TEST_MODE=true

# Optional: let phone-auth specs reset phone_verified for a repeatable full-flow run.
# Point these at the SAME Supabase project the app uses (staging). If unset, the spec
# tolerates an already-verified user.
# E2E_SUPABASE_URL=
# E2E_SUPABASE_SERVICE_KEY=

# ─── Google Business Profile (Admin > Google reviews, /api/cron/gbp-sync) ───
# Admin project only. Until all four are set the daily sync records "not
# connected" and the page shows setup steps. Steps:
#   1. Request Business Profile API access (Google form, approval takes days).
#   2. In the Google Cloud project, enable "My Business Business Information API"
#      and "Google My Business API"; create an OAuth client (Web).
#   3. Get a refresh token for a Google account that manages the profiles,
#      scope https://www.googleapis.com/auth/business.manage
#   4. GBP_ACCOUNT_ID is the numeric id from accounts.list (with or without "accounts/").
GBP_CLIENT_ID=
GBP_CLIENT_SECRET=
GBP_REFRESH_TOKEN=
GBP_ACCOUNT_ID=

# ─── SEO Health (Admin > SEO Health, /api/cron/seo-audit/*) ───
# Admin project only. Without the key, the crawl and the on-page and AI-answer
# checks still run; search data and URL Inspection record "not connected".
# Setup: docs/seo-audit/README.md. Key = base64 of the service account JSON key,
# whose email is a user on the Search Console property. Never commit it.
GSC_SERVICE_ACCOUNT_KEY=
# Optional. Default sc-domain:neramclasses.com (a Domain property covers app.neramclasses.com).
GSC_SITE_URL=
# Optional. The Google account that can use Search Console; added to "Open in Search Console" links as authuser.
GSC_ACCOUNT_EMAIL=
# Optional. 'on' sends the ask-Google pages to Google's Indexing API every morning (see docs/seo-audit/README.md). Unset is off.
SEO_INDEXING_API=
# Optional. Pages a day for the Indexing API (default 50, max 200).
SEO_INDEXING_DAILY=
# Optional. Sites whose sitemaps are audited. Default https://neramclasses.com,https://app.neramclasses.com
SEO_AUDIT_ORIGINS=
# Optional. Monday digest recipients, comma separated. Unset sends nothing.
SEO_DIGEST_TO=
# Optional. Days of search history to keep backfilling (default 90).
SEO_BACKFILL_DAYS=
# Read-only token for /api/cron/seo-audit/findings, used by the weekly Claude Code
# fix job (.github/workflows/seo-autofix.yml). Same value as the GitHub secret.
SEO_EXPORT_TOKEN=
